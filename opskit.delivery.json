{
  "schemaVersion": 2,
  "project": {
    "id": "coolify-demo",
    "name": "OpsKit Coolify Demo",
    "owner": "jiangqizheng",
    "repository": "https://github.com/jiangqizheng/opskit-coolify-demo"
  },
  "placementProfile": "vps-paas",
  "services": [
    {
      "id": "web",
      "name": "Coolify Demo Web",
      "kind": "ssr",
      "environments": [
        {
          "name": "production",
          "releaseOwner": "external-ci",
          "target": {
            "id": "bj-2c8g-coolify-demo",
            "kind": "coolify",
            "provider": "coolify",
            "executor": "coolify",
            "region": "ap-beijing",
            "originRef": null,
            "connectionRef": "pf-env:coolify-primary",
            "resourceRef": "coolify-application:tk82xecroodcuzydwdc4gtn1"
          },
          "desiredRelease": null,
          "healthContract": {
            "process": "required",
            "transport": "required",
            "readiness": "required",
            "domain": "required",
            "dependency": "not-applicable"
          },
          "healthProbes": {
            "process": {
              "kind": "provider",
              "endpointRef": null
            },
            "transport": {
              "kind": "tcp-tls",
              "endpointRef": "tls-probe:coolify-demo.perphq.com/443"
            },
            "readiness": {
              "kind": "https",
              "endpointRef": "https-probe:coolify-demo.perphq.com/healthz"
            },
            "domain": {
              "kind": "https",
              "endpointRef": "https-probe:coolify-demo.perphq.com/"
            },
            "dependency": {
              "kind": "none",
              "endpointRef": null
            }
          },
          "healthFreshness": {
            "process": {
              "maxAgeMinutes": 5,
              "allowedSources": [
                "executor",
                "provider"
              ]
            },
            "transport": {
              "maxAgeMinutes": 5,
              "allowedSources": [
                "probe"
              ]
            },
            "readiness": {
              "maxAgeMinutes": 5,
              "allowedSources": [
                "probe"
              ]
            },
            "domain": {
              "maxAgeMinutes": 10,
              "allowedSources": [
                "probe"
              ]
            },
            "dependency": {
              "maxAgeMinutes": null,
              "allowedSources": [
                "manual"
              ]
            }
          },
          "executionPolicy": {
            "timeoutMs": 600000,
            "maxAttempts": 2,
            "rollbackMode": "manual",
            "approvalMode": "operator"
          },
          "backupContract": {
            "required": false,
            "owner": "platform",
            "destinationRef": null,
            "retentionDays": null,
            "rpoMinutes": null,
            "restoreDrillMaxAgeMinutes": null,
            "rtoMinutes": null,
            "restoreProcedureRef": null
          }
        }
      ]
    }
  ]
}
